# Copy this file to .env.local and fill in your own Supabase project's values.
#   cp .env.example .env.local
# Find them in the Supabase dashboard: Project Settings -> API Keys / Data API.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy "anon public" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (sb_secret_...) or the legacy "service_role" key.
# Server-only. Never expose to the browser, never commit it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. One-click training in the Testing tab only runs under `npm run dev` on localhost.
# Set to 1 to also allow it under `npm run start` on your own machine. Never set this on Vercel.
# SUPABOX_LOCAL_TRAINING=1
