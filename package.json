{
  "name": "supabox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:yolo": "node --experimental-strip-types src/lib/yolo/convert.test.ts",
    "test:detect": "node --experimental-strip-types src/lib/yolo/detect.test.ts",
    "db:link": "npx supabase link",
    "db:migrate": "npx supabase db push",
    "db:generate": "npx supabase db diff -f",
    "db:pull": "npx supabase db pull",
    "db:compare": "npx supabase db diff --linked",
    "db:types": "npx supabase gen types typescript --linked > src/types/supabase.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic-to": "1.5.2",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "onnxruntime-web": "1.29.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
